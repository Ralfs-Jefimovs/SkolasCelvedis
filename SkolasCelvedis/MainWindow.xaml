<Window x:Class="SkolasCelvedis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="MainWindow" Height="900" Width="1600" WindowState="Maximized" WindowStyle="SingleBorderWindow">

    <Grid Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!--The part which contains the header bar-->
        
            <Border Grid.Row="0"
                Background="#82181a">
            <DockPanel VerticalAlignment="Center" Margin="15,0">
                <Image DockPanel.Dock="Right"
                       Source="\Images\logo.png"
                       Width="50"
                       Height="50"
                       Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15, 0">

                <Label Content="Meklēšanas lauks"
                       Foreground="White"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>

                    <Grid Margin="0,0,12,0">
                        <TextBox x:Name="SearchTextBox"
                        Width="180"
                        Height="30"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Center"
                        KeyDown="SearchTextBox_KeyDown"
                        TextChanged="SearchTextBox_TextChanged"/>

                    </Grid>
                    <ComboBox x:Name="BuildingComboBox"
                          Width = "160"
                          Height="30"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Margin="0,0,12,0"
                          SelectionChanged="BuildingComboBox_SelectionChanged">
                    <ComboBoxItem Content="Administratīvais korpuss"/>
                    <ComboBoxItem Content="Laboratorijas korpuss"/>
                    <ComboBoxItem Content="Darbnīcas"/>
                </ComboBox>
                <ComboBox x:Name="FloorComboBox"
                          Width="160"
                          Height="30"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Margin="0,0,12,0"
                          SelectionChanged="FloorComboBox_SelectionChanged">
                </ComboBox>

                    <Button x:Name="ReturnToOriginButton"
                        Content="Atgriezties uz sākumu"
                        Click="ReturnToOriginButton_Click"
                        Width="155"
                        Height="30"
                        Margin="0,0,12,0"
                        Style="{StaticResource HeaderButton}"/>

                    <Button x:Name="ViewEmployeeButton"
                        Content="Apskatīt darbinieku sarakstu"
                        Click="ViewEmployeeButton_Click"
                        Visibility="Visible"
                        Width="200"
                        Height="30"
                        Style="{StaticResource HeaderButton}"/>


                    <Button x:Name="DebugWaypointsButton"
                            Content="Show Waypoints"
                            Click="DebugWaypointsButton_Click"
                            Visibility="Hidden"
                            Width="130"
                            Height="30"
                            Margin="0,0,12,0"
                            Style="{StaticResource HeaderButton}"/>


                </StackPanel>
          </DockPanel>
        </Border>

        <Popup x:Name="SuggestionPopup"
           Grid.Row="0"
           PlacementTarget="{Binding ElementName=SearchTextBox}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">
            <Border Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="2">
                <ListBox x:Name="SuggestionBox"
                     SelectionChanged="SuggestionBox_SelectionChanged"
                     MaxHeight="300"
                     Width="180"
                     BorderThickness="0"
                     Background="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}"
                       FontWeight="Bold"
                       FontSize="13"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FloorName}"
                           Foreground="Gray"
                           FontSize="11"/>
                                    <TextBlock Text=" · "
                           Foreground="Gray"
                           FontSize="11"/>
                                    <TextBlock Text="{Binding Type}"
                           Foreground="Gray"
                           FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AssignedEmployee}"
                       Foreground="#4A90D9"
                       FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>



        <!--The part which contains the map-->
        <Grid Grid.Row="1"
              x:Name="TransformWrapper"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ClipToBounds="True"
              Background="Transparent"
              MouseWheel="Map_MouseWheel"
              MouseLeftButtonDown="Map_MouseLeftButtonDown"
              MouseMove="Map_MouseMove"
              MouseLeftButtonUp="Map_MouseLeftButtonUp"
              >

            <Grid x:Name="MapTransformGrid"
                  Background="Transparent">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <svgc:SvgCanvas x:Name="FloorSvgCanvas"
                                Source="/Floors/first_floor.svg"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"/>
            </Grid>

            <Border x:Name="RoomInfoPanel"
        Width="260"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="White"
        BorderBrush="#DDDDDD"
        BorderThickness="1,0,0,0"
        Panel.ZIndex="20"
        Visibility="Collapsed"
        MaxHeight="860">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- Close button -->
                        <Button x:Name="CloseInfoPanelButton"
                    Content="✕"
                    HorizontalAlignment="Right"
                    Width="28" Height="28"
                    Click="CloseInfoPanel_Click"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="14"
                    Cursor="Hand"/>

                        <!-- Room name -->
                        <TextBlock x:Name="InfoRoomName"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,4,0,4"/>

                        <!-- Floor -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock x:Name="InfoFloorName"
                           FontSize="13"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Type -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock x:Name="InfoRoomType"
                           FontSize="13"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,12"/>

                        <!-- Employee section -->
                        <TextBlock Text="Darbinieks"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="InfoEmployeeName"
                           FontSize="13"
                           Foreground="#3a7bd5"
                           TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock x:Name="InfoSubjectName"
                           FontSize="13"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Edit panel - only visible for admin -->
                        <StackPanel x:Name="RoomEditPanel" Visibility="Collapsed">
                            <Separator Margin="0,12,0,12"/>

                            <TextBlock Text="Rediģēt kabinetu"
                           FontWeight="Bold"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                            <TextBlock Text="Darbinieks" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EditEmployeeCombo"
                          Height="28"
                          Margin="0,0,0,8"/>

                            <TextBlock Text="Telpas tips" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EditSubjectCombo"
                          Height="28"
                          Margin="0,0,0,8"/>

                            <Button x:Name="SaveRoomButton"
                        Content="Saglabāt"
                        Click="SaveRoomButton_Click"
                        Height="36"
                        FontSize="13"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#82181a"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="12,8">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#82181a"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#82181a"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>



            <Button x:Name="NavigateButton"
                    Content="Izveidot maršrutu"
                    Visibility="Collapsed"
                    Click="NavigateButton_Click"
                    Width="350"
                    Height="120"
                    FontSize="36"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,40"
                    Panel.ZIndex="10">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#82181a"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#a01e21"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#5a0f11"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>