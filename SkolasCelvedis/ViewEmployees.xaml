<Window x:Class="SkolasCelvedis.ViewEmployees"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darbinieku saraksts" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Darbinieku saraksts" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ Pievienot darbinieku"
                    x:Name="AddNewButton"
                    Click="AddNewButton_Click"
                    Margin="20,0,0,0" Padding="12,6"
                    Background="#82181a" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Employee list -->
        <DataGrid Grid.Row="1"
                  x:Name="EmployeeDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserResizeRows="False"
                  SelectionChanged="EmployeeDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vārds" Binding="{Binding FirstName}" Width="130"/>
                <DataGridTextColumn Header="Uzvārds" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Kabinets" Binding="{Binding RoomName}" Width="160"/>
                <DataGridTextColumn Header="Priekšmets" Binding="{Binding SubjectName}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Rediģēt"
                    x:Name="EditButton"
                    Click="EditButton_Click"
                    IsEnabled="False"
                    Padding="14,6" Margin="0,0,10,0"
                    Background="#3a7bd5" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Content="Dzēst"
                    x:Name="DeleteButton"
                    Click="DeleteButton_Click"
                    IsEnabled="False"
                    Padding="14,6"
                    Background="#c0392b" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>