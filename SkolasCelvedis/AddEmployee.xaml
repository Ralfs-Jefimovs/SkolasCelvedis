<Window x:Class="SkolasCelvedis.AddEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkolasCelvedis"
        mc:Ignorable="d"
        Title="AddEmployee" Height="250" Width="350">
    <StackPanel Margin="20">
        <TextBlock Text="Vārds"></TextBlock>
        <TextBox x:Name="NameTextBox" Margin="0,5,0,10"></TextBox>

        <TextBlock Text="Uzvārds"></TextBlock>
        <TextBox x:Name="LastNameTextBox" Margin="0,5,0,10"></TextBox>

        <Button Content="Saglabāt" Click="SaveButton_Click" Margin="0,10,0,0"></Button>
        
    </StackPanel>
</Window>
